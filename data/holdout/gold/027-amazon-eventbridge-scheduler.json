    {
      "name": "Invocations throttle limit in transactions per second",
      "default": "us-east-1: 1,000; us-east-2: 1,000; us-west-2: 1,000; ap-northeast-1: 1,000; ap-south-1: 1,000; ap-southeast-1: 1,000; ap-southeast-2: 1,000; eu-central-1: 1,000; eu-west-1: 1,000; eu-west-2: 1,000; sa-east-1: 1,000; Each of the other supported Regions: 500",
