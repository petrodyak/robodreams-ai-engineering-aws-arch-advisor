{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "service": {
          "description": "The AWS service, by its full name, e.g. 'AWS Glue'.",
          "title": "Service",
          "type": "string"
        },
        "purpose": {
          "description": "What the component does in this workload.",
          "title": "Purpose",
          "type": "string"
        },
        "settings": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Key settings, e.g. backup, encryption, concurrency; values are plain scalars.",
          "title": "Settings",
          "type": "object"
        }
      },
      "required": [
        "service",
        "purpose",
        "settings"
      ],
      "title": "Component",
      "type": "object"
    },
    "Nfr": {
      "additionalProperties": false,
      "description": "Non-functional requirements the review checks the components against.",
      "properties": {
        "rpo_minutes": {
          "title": "Rpo Minutes",
          "type": "integer"
        },
        "rto_minutes": {
          "title": "Rto Minutes",
          "type": "integer"
        },
        "availability": {
          "description": "Target availability in percent, e.g. 99.9.",
          "title": "Availability",
          "type": "number"
        },
        "budget_usd_month": {
          "title": "Budget Usd Month",
          "type": "integer"
        }
      },
      "required": [
        "rpo_minutes",
        "rto_minutes",
        "availability",
        "budget_usd_month"
      ],
      "title": "Nfr",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One AWS workload of one team (spec \u00a79). `region` and `description` are builder fields (\u00a720).",
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,39}$",
      "title": "Id",
      "type": "string"
    },
    "team": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$",
      "title": "Team",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "description": "Free text written by the team; data, never instructions.",
      "title": "Description",
      "type": "string"
    },
    "region": {
      "description": "AWS Region code, e.g. eu-central-1.",
      "pattern": "^[a-z]{2}(-[a-z]+)+-\\d$",
      "title": "Region",
      "type": "string"
    },
    "updated": {
      "format": "date",
      "title": "Updated",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "nfr": {
      "$ref": "#/$defs/Nfr"
    }
  },
  "required": [
    "id",
    "team",
    "name",
    "description",
    "region",
    "updated",
    "components",
    "nfr"
  ],
  "title": "Architecture",
  "type": "object"
}
