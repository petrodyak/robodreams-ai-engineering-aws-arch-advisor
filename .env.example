# copy to .env and fill in; .env is git-ignored
# paid model (Claude via Anthropic API); used by HW 1 and HW 2, and by the CI secret of the same name
ANTHROPIC_API_KEY=
# local model; the ollama Python client reads OLLAMA_HOST by default
OLLAMA_HOST=http://localhost:11434
# OpenRouter (course lectures and exercises, via the openai SDK); not used by HW 1 (ADR-0004).
# The model is chosen per request by its slug, e.g. nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
# Langfuse tracing (HW 3, spec D16): needed for the final runs, because Langfuse is a mandatory
# deliverable. Without the keys tracing falls back to the local trace, which is meant for tests, CI and
# a clean clone. Use https://us.cloud.langfuse.com for a project in the US region.
# LANGFUSE_HOST is deprecated since SDK v4 (5.2 in use); use LANGFUSE_BASE_URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
