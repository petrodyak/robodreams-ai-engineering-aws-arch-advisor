# copy to .env and fill in; .env is git-ignored
# paid model (Claude via Anthropic API); used by HW 1 and HW 2, and by the CI secret of the same name
ANTHROPIC_API_KEY=
# local model; the ollama Python client reads OLLAMA_HOST by default
OLLAMA_HOST=http://localhost:11434
# OpenRouter (course lectures and exercises, via the openai SDK); not used by HW 1 (ADR-0004).
# The model is chosen per request by its slug, e.g. nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
