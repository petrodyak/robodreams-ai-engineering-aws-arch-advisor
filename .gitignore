var/
# superpowers plan-execution workspace (local ledger, not project history)
.superpowers/
# python
.venv/
__pycache__/
*.pyc
# os / ide
.DS_Store
.idea/
.vscode/
# claude.ai project context (CLAUDE.md is the in-repo source of truth)
Context.md
# agent eval runs: the per-task SQLite stores are scratch; summary.json and traces are kept
evals/agent/results/*/db/
